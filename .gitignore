dist/
build/
.next/
out/
.output/
*.tsbuildinfo

# ── Variables de entorno ──
.env
.env.*
!.env.example
!.env.prueba.example

# ── Logs ──
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── Coverage / tests ──
coverage/
.nyc_output/

# ── Docker ──
docker/nginx/logs/

# ── Marcas de despliegue, una por maquina ──
.desplegado
.construido

# ── Editor ──
.vscode/
.idea/
*.swp
*.swo

# ── Herramientas locales (Claude Code, etc.) ──
.claude/

