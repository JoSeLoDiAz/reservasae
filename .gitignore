# ── Dependencias ──
node_modules/
.pnpm-store/

# ── Build outputs ──
dist/
build/
.next/
out/
.output/
*.tsbuildinfo

# ── Variables de entorno ──
.env
.env.*
!.env.example
!.env.prueba.example

# ── Logs ──
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── Coverage / tests ──
coverage/
.nyc_output/

# ── Docker ──
docker/nginx/logs/

# ── Marcas de despliegue, una por maquina ──
.desplegado
.construido

# ── Editor ──
.vscode/
.idea/
*.swp
*.swo

# ── Herramientas locales (Claude Code, etc.) ──
# Los ajustes locales no se comparten, pero las fichas de los subagentes sí:
# son parte de la arquitectura, no de la máquina de cada uno. Se excluye el
# contenido de la carpeta y se rescata `agents/` --hace falta el `/*`, porque
# si se ignora el directorio entero git no baja a mirar dentro.
.claude/*
!.claude/agents/

# ── OS ──
.DS_Store
Thumbs.db

# ── Prisma ──
# El cliente se genera en cada build (backend/Dockerfile lo hace antes de
# compilar). Versionarlo solo trae conflictos y binarios en el repo.
backend/generated/

# ── Exportes del SEP: llevan datos de personas reales ──
docs/sep/*.xlsx
docs/sep/*.xls

# el lienzo de diseno exportado: 2,2 MB de editor empaquetado
# por archivo, y se regenera desde los .dc.html de al lado
bosquejo*/preinscripcion-convoca.html

# el perfil del navegador que consulta NITs: 32 MB de galletas
.perfil-buscador/

# Frascos de galletas de curl y volcados de sesión.
#
# Aquí acabó `ana.txt`: una cookie de sesión de administrador
# de prueba.reservasae.com, firmada con el ADMIN_JWT_SECRET de
# ese entorno, en un repositorio PÚBLICO. Que estuviera vencida
# no la hace inofensiva: una firma HS256 publicada se puede
# atacar sin tocar el servidor y sin que nadie lo note.
*.cookies
*.cookie
cookies.txt
galletas.txt

# Sondas de usar y tirar de las revisiones adversariales.
#
# Los subagentes escriben specs temporales para comprobar una
# afirmacion contra el codigo, y con un `git add -A` se cuelan en
# un commit. No son tests del proyecto: corren en cada `pnpm test`
# y un dia uno falla y nadie sabe que protegia.
#
# El prefijo `zz` no es casual: los ordena al final y se ven de un
# vistazo. Un spec de verdad NUNCA se llama asi.
backend/src/**/zz*.spec.ts
frontend/src/**/zz*.spec.ts
