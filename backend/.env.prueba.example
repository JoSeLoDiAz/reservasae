# copiar a backend/.env.prueba, que no se sube a git
# entorno de pruebas: base y secreto PROPIOS, nunca los de produccion

NODE_ENV=production
PORT=4000
APP_VERSION=0.1.0-prueba

# marca la franja, y sin ella la siembra falsa se niega
ENTORNO=prueba

# postgres: otra base, otro usuario, otra clave
POSTGRES_USER=reservasae_prueba
POSTGRES_PASSWORD=cambiar-esta-clave-de-pruebas
POSTGRES_DB=reservasae_prueba

# dentro de Docker el host es `db-prueba`
DATABASE_URL=postgresql://reservasae_prueba:cambiar-esta-clave-de-pruebas@db-prueba:5432/reservasae_prueba?schema=public

# fuera de Docker, por el puerto publicado
# DATABASE_URL=postgresql://reservasae_prueba:cambiar-esta-clave-de-pruebas@localhost:5434/reservasae_prueba?schema=public

# distinto al de produccion: una sesion de aqui no
# debe valer alla. Minimo 32 caracteres.
ADMIN_JWT_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio-solo-de-pruebas
