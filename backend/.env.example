# Copiar a backend/.env y ajustar. backend/.env NO se sube a git.

# ── Backend ──
NODE_ENV=production
PORT=4000
APP_VERSION=0.1.0

# ── Postgres ──
# Lo leen tanto el servicio `db` (para crear el cluster) como el backend.
POSTGRES_USER=reservasae
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=reservasae

# Dentro de Docker el host es `db` (nombre del servicio en docker-compose).
DATABASE_URL=postgresql://reservasae:cambiar-esta-clave@db:5432/reservasae?schema=public

# Para correr el backend fuera de Docker contra la BD del servidor,
# usar el puerto publicado en localhost:
# DATABASE_URL=postgresql://reservasae:cambiar-esta-clave@localhost:5433/reservasae?schema=public

# ── Panel de administración ──
# Firma las cookies de sesión del panel. OBLIGATORIA: el backend no arranca
# sin ella. Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
