# copiar a backend/.env, que no se sube a git

# backend
NODE_ENV=production
PORT=4000
APP_VERSION=0.1.0

# postgres: para el contenedor db y el backend
POSTGRES_USER=reservasae
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=reservasae

# dentro de Docker el host es `db`
DATABASE_URL=postgresql://reservasae:cambiar-esta-clave@db:5432/reservasae?schema=public

# fuera de Docker, por el puerto publicado
# DATABASE_URL=postgresql://reservasae:cambiar-esta-clave@localhost:5433/reservasae?schema=public

# panel: obligatoria, minimo 32 caracteres
ADMIN_JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# --- correo saliente (SMTP) ---
# Sin las tres primeras no se manda nada, y se dice en el
# registro en vez de fingir que salio.
# SMTP_SERVIDOR=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_USUARIO=
# Con Google Workspace va una «contrasena de aplicacion» de
# 16 letras, NO la contrasena de la cuenta.
# SMTP_CLAVE=
# SMTP_DESDE=
# SMTP_NOMBRE=Convoca

# --- consulta al RUI (Ventanilla Social del DNP) ---
# El worker esta apagado salvo que se encienda a proposito:
# un `.env` de portatil puede apuntar a la base de verdad.
# RUI_WORKER=1
# Sin esto usa el simulador y NO consulta el portal:
# RUI_PROVEEDOR=VENTANILLA
# En la imagen de Docker el navegador ya viene puesto en
# CHROMIUM_RUTA. Esto solo si hace falta otro:
# RUI_NAVEGADOR_RUTA=

# --- buscador web para validar empresas por NIT ---
# Esto enciende al que vacia la cola solo:
# WEB_WORKER=1
#
# EN UN COMPUTADOR CON PANTALLA (el portatil de un analista)
# no hay que poner nada mas: arranca su propio Chrome, con su
# propio perfil y fuera de la pantalla, y pregunta gratis.
#
# EN EL SERVIDOR eso NO funciona: no hay pantalla, y el
# buscador rechaza los navegadores ocultos con «trafico
# inusual». Alli va por API, que si funciona sin pantalla y
# cobra unos centavos por NIT:
# WEB_PROVEEDOR=API
# WEB_API_KEY=
#
# Si se quiere intentar igual el navegador en el servidor, la
# imagen puede levantar una pantalla virtual con Xvfb. Puede
# funcionar o no, segun la reputacion de la IP del servidor:
# WEB_CON_CABEZA=1
#
# Otros, casi nunca hacen falta:
# WEB_NAVEGADOR_RUTA=
# WEB_NAVEGADOR_CDP=http://127.0.0.1:9222
