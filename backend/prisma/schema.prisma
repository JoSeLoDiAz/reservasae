// Modelo de datos de Convoca.
//
// El cliente se genera FUERA de node_modules para que el build de Docker lo
// copie con una ruta predecible. Como `src/` y `dist/` cuelgan ambos de
// `backend/`, el import relativo `../generated/prisma` resuelve igual antes y
// después de compilar.
generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"] // los contenedores son alpine
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

/// Las tres que usan los proyectos. `HIBRIDA` es la "PRESENCIAL HÍBRIDA" del
/// formato SENA: un mismo grupo junta asistentes en sede y conectados en vivo
/// (los dos foros de 2 horas). Solo la llevan la acción y el grupo; una oferta
/// concreta siempre es una cosa o la otra, porque o se va a la sede o no.
enum Modalidad {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
}

enum TipoUbicacion {
  CIUDAD
  DEPARTAMENTO
}

/// Cada convenio bajo el que se oferta la formación. Hoy son dos, pero el
/// sistema no asume ese número: la ruta pública sale del `slug`.
model Convenio {
  id                 String   @id @default(cuid())
  slug               String   @unique /// ruta pública: /britcham-adee, /adecopria
  nombre             String /// razón social de la entidad proponente
  sigla              String?
  nit                String
  digitoVerificacion String?
  correo             String?
  telefono           String?
  direccion          String?
  ciudad             String?
  departamento       String?
  paginaWeb          String?
  activo             Boolean  @default(true)
  orden              Int      @default(0)
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  acciones    AccionFormacion[]
  politicas   PoliticaDatos[]
  formularios Formulario[]

  @@map("convenios")
}

/// Una acción de formación del proyecto (AF1, AF2...). Los admins pueden
/// editarlas, reordenarlas y ocultarlas, pero NO borrarlas cuando ya tienen
/// reservas: `visible` las saca del sitio público sin destruir el histórico.
model AccionFormacion {
  id          String    @id @default(cuid())
  convenioId  String
  codigo      String /// "AF1"; es como se refieren a ella el proyecto y el SENA
  nombre      String
  modalidad   Modalidad
  evento      String? /// CURSO, SEMINARIO...
  enfoque     String?
  metodologia String?
  horas       Int?
  objetivo    String?
  ambiente    String?

  visible       Boolean  @default(false) /// arranca oculta: se publica cuando tiene fechas
  orden         Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  convenio Convenio @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  grupos   Grupo[]
  ofertas  Oferta[]

  // El código solo es único dentro de su convenio: BRITCHAM y ADECOPRIA
  // tienen ambos una AF1, y son cursos completamente distintos.
  @@unique([convenioId, codigo])
  @@index([convenioId, visible, orden])
  @@map("acciones_formacion")
}

/// Ubicación normalizada. La tabla existe porque el Excel escribía el mismo
/// departamento de tres formas ("ATLÁNTICO ", "Cundinamarca", "CUNDINAMARCA")
/// y porque una misma palabra significaba dos cosas: en la AF8 "ANTIOQUIA" era
/// en realidad la sede presencial de MEDELLÍN, no el departamento.
model Ubicacion {
  id           String        @id @default(cuid())
  nombre       String
  tipo         TipoUbicacion
  departamento String? /// para las ciudades: a qué departamento pertenecen

  coberturas GrupoCobertura[]
  ofertas    Oferta[]
  sedeDe     Grupo[]

  @@unique([nombre, tipo])
  @@map("ubicaciones")
}

/// Un grupo (cohorte) de una acción de formación, tal como está comprometido en
/// el proyecto. Aquí NO vive el contador de cupos: el público reserva por
/// acción + ubicación y el reparto en grupos lo hace después el equipo.
model Grupo {
  id                String    @id @default(cuid())
  accionFormacionId String
  numero            Int
  modalidad         Modalidad
  sedeUbicacionId   String? /// solo si el grupo tiene componente presencial

  // Los proyectos no traen fechas. Sin ellas un grupo no se puede publicar,
  // así que las cargan los admins antes de abrir inscripciones.
  fechaInicio DateTime?
  fechaFin    DateTime?
  horario     String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  accionFormacion AccionFormacion  @relation(fields: [accionFormacionId], references: [id], onDelete: Cascade)
  sede            Ubicacion?       @relation(fields: [sedeUbicacionId], references: [id])
  coberturas      GrupoCobertura[]

  @@unique([accionFormacionId, numero])
  @@map("grupos")
}

/// Cuántos beneficiarios aporta un grupo en una ubicación concreta. Es el
/// reflejo fiel de la hoja `Datos_Cobertura` del proyecto y sirve para reportar
/// al SENA. Un grupo híbrido (AF8) tiene aquí una fila presencial en su sede y
/// varias virtuales repartidas por departamento.
model GrupoCobertura {
  id           String    @id @default(cuid())
  grupoId      String
  ubicacionId  String
  modalidad    Modalidad
  cuposBase    Int /// lo comprometido en el proyecto, sin sobrecupo
  cuposMaximos Int /// cuposBase + 30 %, truncado

  grupo     Grupo     @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  ubicacion Ubicacion @relation(fields: [ubicacionId], references: [id])

  @@unique([grupoId, ubicacionId, modalidad])
  @@map("grupos_cobertura")
}

// ---------------------------------------------------------------------------
// Oferta: la unidad que tiene cupos y contra la que se reserva
// ---------------------------------------------------------------------------

/// (acción de formación × ubicación). Es lo que ve el público y lo único que
/// lleva contador de cupos, para que no haya dos números que se puedan
/// desincronizar.
///
/// `cuposMaximos` YA incluye el 30 % de sobrecupo por deserción; es el tope
/// duro de reservas confirmadas. La base sin inflar queda en `GrupoCobertura`
/// y en `docs/proyectos/`, por si algún día hay que recalcular el porcentaje.
model Oferta {
  id                String    @id @default(cuid())
  accionFormacionId String
  ubicacionId       String
  modalidad         Modalidad

  cuposMaximos  Int
  cuposOcupados Int @default(0)

  /// Cerrar una oferta impide reservas nuevas sin tocar las existentes.
  abierta       Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  accionFormacion AccionFormacion @relation(fields: [accionFormacionId], references: [id], onDelete: Cascade)
  ubicacion       Ubicacion       @relation(fields: [ubicacionId], references: [id])
  reservas        Reserva[]

  @@unique([accionFormacionId, ubicacionId])
  @@index([accionFormacionId])
  @@map("ofertas")
}

// ---------------------------------------------------------------------------
// Empresas y reservas
// ---------------------------------------------------------------------------

/// La organización que reserva, identificada por su NIT. Quien diligencia el
/// formulario lo hace en nombre de ella y puede no ser quien asiste.
model Empresa {
  id                  String  @id @default(cuid())
  nit                 String /// solo dígitos, sin puntos ni guion
  digitoVerificacion  String?
  razonSocial         String
  numeroColaboradores Int?
  redAsociada         String? /// BRITCHAM / ADEE / Ambos / Otro / Ninguno
  /// Cuál, cuando `redAsociada` es "Otro". En columna aparte y no mezclado
  /// dentro de `redAsociada`: así el informe puede agrupar por gremio sin
  /// tener que partir cadenas de texto.
  redAsociadaOtra     String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  reservas Reserva[]

  // Un NIT = una organización. Es la defensa contra que la misma empresa entre
  // dos veces escrita distinto y acabe con dos cuentas de cupos.
  @@unique([nit])
  @@map("empresas")
}

enum EstadoReserva {
  CONFIRMADA /// tiene al menos un cupo confirmado
  LISTA_ESPERA /// no cabía ninguno; espera a que alguien cancele
  CANCELADA
}

/// Una reserva de N cupos de una empresa sobre una oferta. No es una
/// inscripción individual: guarda una cantidad, no personas. La empresa puede
/// volver con su NIT y subir o bajar esa cantidad.
///
/// Si al reservar 10 solo caben 6, se confirman 6 y los otros 4 quedan en
/// espera: por eso los cupos se reparten en dos contadores dentro de la misma
/// fila, en vez de crear dos reservas.
model Reserva {
  id        String @id @default(cuid())
  empresaId String
  ofertaId  String

  cuposSolicitados Int
  cuposConfirmados Int @default(0)
  cuposEnEspera    Int @default(0)

  estado EstadoReserva @default(CONFIRMADA)

  // Quien diligencia. Se guarda en la reserva y no en la empresa porque puede
  // ser una persona distinta en cada curso.
  contactoNombre  String
  contactoCorreo  String
  contactoCelular String?
  contactoCargo   String?

  aceptaTerminos      Boolean @default(false)
  aceptaPoliticaDatos Boolean @default(false)
  politicaDatosId     String? /// qué versión exacta del texto aceptó

  ipOrigen String? /// llega en CF-Connecting-IP, no en el socket

  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  canceladaEn   DateTime?

  empresa       Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  oferta        Oferta              @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  politicaDatos PoliticaDatos?      @relation(fields: [politicaDatosId], references: [id])
  movimientos   MovimientoReserva[]
  respuestas    Respuesta[]

  // La defensa real contra el doble clic y contra los reintentos de Cloudflare:
  // una empresa tiene como mucho UNA reserva por oferta. Un segundo envío no
  // crea otra fila, edita la que ya existe. La base lo rechaza aunque lleguen
  // dos peticiones en el mismo milisegundo.
  @@unique([empresaId, ofertaId])
  @@index([ofertaId, estado])
  @@index([contactoCorreo])
  @@map("reservas")
}

enum AccionMovimiento {
  CREACION
  EDICION
  CANCELACION
  PROMOCION_LISTA_ESPERA
  AJUSTE_ADMIN
}

/// Auditoría de cada cambio de cupos. Es obligatoria porque para editar una
/// reserva basta con saber el NIT, y el NIT es información pública: si alguien
/// vacía la reserva de otra empresa, esto es lo único que permite reconstruir
/// qué pasó y desde dónde.
model MovimientoReserva {
  id        String           @id @default(cuid())
  reservaId String
  accion    AccionMovimiento

  confirmadosAntes   Int
  confirmadosDespues Int
  enEsperaAntes      Int
  enEsperaDespues    Int

  ip        String?
  userAgent String?
  adminId   String?
  nota      String?
  creadoEn  DateTime @default(now())

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  admin   Admin?  @relation(fields: [adminId], references: [id])

  @@index([reservaId, creadoEn])
  @@map("movimientos_reserva")
}

// ---------------------------------------------------------------------------
// Formularios administrables
// ---------------------------------------------------------------------------

enum TipoPregunta {
  TEXTO_CORTO
  TEXTO_LARGO
  NUMERO
  CORREO
  TELEFONO
  FECHA
  SELECCION_UNICA
  SELECCION_MULTIPLE
  CASILLA
  /// No pide nada: solo muestra un texto en medio del formulario. Sirve para
  /// avisos y para el texto legal antes de la casilla de autorización.
  PARRAFO
}

/// Un formulario público. Los admins crean y editan sus preguntas desde el
/// panel, sin migraciones.
model Formulario {
  id          String  @id @default(cuid())
  convenioId  String
  slug        String  @unique
  titulo      String
  descripcion String?
  publicado   Boolean @default(false)

  /// Texto de la pantalla de confirmación, tras reservar.
  mensajeExito String?

  /// Apariencia propia. Solo las claves que el admin cambió; el resto hereda
  /// de la marca general. Guardar las 28 rompería esa herencia.
  coloresClaro  Json?
  coloresOscuro Json?

  logoDatos    Bytes?
  logoTipoMime String?
  logoNombre   String?
  logoVersion  Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  convenio  Convenio   @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  secciones Seccion[]
  preguntas Pregunta[]

  @@map("formularios")
}

/// Bloque visual del formulario ("Datos de la organización", "Cupos"...).
/// Existe porque un formulario de veinte campos seguidos no lo llena nadie.
model Seccion {
  id           String  @id @default(cuid())
  formularioId String
  titulo       String
  descripcion  String?
  orden        Int     @default(0)

  formulario Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  preguntas  Pregunta[]

  @@index([formularioId, orden])
  @@map("secciones")
}

/// Los campos que el núcleo transaccional necesita sí o sí (NIT, cantidad de
/// cupos, oferta elegida...) no pueden depender de que un admin no borre la
/// pregunta. Una pregunta mapeada a un campo del núcleo se marca aquí y el
/// panel impide eliminarla o cambiarle el tipo.
enum CampoNucleo {
  EMPRESA_NIT
  EMPRESA_RAZON_SOCIAL
  EMPRESA_COLABORADORES
  EMPRESA_RED_ASOCIADA
  EMPRESA_RED_ASOCIADA_OTRA
  CONTACTO_NOMBRE
  CONTACTO_CORREO
  CONTACTO_CELULAR
  CONTACTO_CARGO
  ACCION_FORMACION
  OFERTA
  CUPOS_SOLICITADOS
  ACEPTA_TERMINOS
  ACEPTA_POLITICA_DATOS
}

model Pregunta {
  id           String       @id @default(cuid())
  formularioId String
  seccionId    String?
  etiqueta     String
  ayuda        String?
  marcador     String? /// texto gris dentro del campo vacío
  tipo         TipoPregunta
  obligatoria  Boolean      @default(false)
  orden        Int          @default(0)
  campoNucleo  CampoNucleo?

  /// Reglas de validación. Se aplican en el navegador y otra vez en el
  /// servidor: lo primero es comodidad, lo segundo es lo que de verdad
  /// protege los datos.
  minimo      Int? /// valor mínimo, para NUMERO
  maximo      Int?
  largoMinimo Int? /// caracteres, para los tipos de texto
  largoMaximo Int?

  /// Mostrar esta pregunta solo si otra tiene cierto valor. Es lo que permite
  /// el clásico "Otro → ¿cuál?" sin escribirlo en el código.
  dependeDePreguntaId String?
  dependeDeValor      String?

  /// Las preguntas no se borran: se archivan. Borrarlas dejaría respuestas
  /// huérfanas y rompería la exportación histórica.
  archivada Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  formulario Formulario  @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  seccion    Seccion?    @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  opciones   Opcion[]
  respuestas Respuesta[]

  // Una pregunta no puede depender de sí misma ni arrastrar a la que la
  // condiciona si esta desaparece.
  dependeDe    Pregunta?  @relation("Dependencia", fields: [dependeDePreguntaId], references: [id], onDelete: SetNull)
  dependientes Pregunta[] @relation("Dependencia")

  // Un campo del núcleo se pide una sola vez por formulario.
  @@unique([formularioId, campoNucleo])
  @@index([formularioId, orden])
  @@index([seccionId, orden])
  @@map("preguntas")
}

model Opcion {
  id         String  @id @default(cuid())
  preguntaId String
  etiqueta   String
  /// Lo que se guarda. Se separa de la etiqueta para poder corregir la
  /// redacción sin invalidar las respuestas ya recogidas.
  valor      String
  orden      Int     @default(0)
  archivada  Boolean @default(false)

  pregunta Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  @@unique([preguntaId, valor])
  @@index([preguntaId, orden])
  @@map("opciones")
}

/// La respuesta guarda además el texto de la pregunta y de la opción tal como
/// estaban al enviarse. Si un admin reescribe la pregunta después, lo
/// exportado sigue diciendo lo que la persona realmente contestó.
model Respuesta {
  id         String @id @default(cuid())
  reservaId  String
  preguntaId String

  etiquetaPregunta   String
  valorTexto         String?
  valorNumero        Int?
  valorBooleano      Boolean?
  valoresSeleccion   String[] @default([])
  /// Las etiquetas de las opciones elegidas, congeladas al enviar. Si mañana
  /// alguien reescribe una opción, la exportación sigue diciendo lo que la
  /// persona leyó al marcarla.
  etiquetasSeleccion String[] @default([])

  creadoEn DateTime @default(now())

  reserva  Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  pregunta Pregunta @relation(fields: [preguntaId], references: [id])

  @@unique([reservaId, preguntaId])
  @@map("respuestas")
}

// ---------------------------------------------------------------------------
// Política de datos y administración
// ---------------------------------------------------------------------------

/// El texto legal se versiona. La reserva apunta a la versión concreta que se
/// aceptó: si mañana cambia el aviso, no se puede afirmar que quien firmó hace
/// seis meses aceptó el texto nuevo.
model PoliticaDatos {
  id           String    @id @default(cuid())
  convenioId   String
  version      Int
  titulo       String
  contenido    String /// texto completo en markdown
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime?

  convenio Convenio  @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  reservas Reserva[]

  @@unique([convenioId, version])
  @@map("politicas_datos")
}

enum EsquemaColor {
  CLARO
  OSCURO
}

enum ModoPorDefecto {
  SISTEMA
  CLARO
  OSCURO
}

/// Una paleta completa por esquema. Son dos filas fijas, CLARO y OSCURO.
///
/// No basta con oscurecer los colores del tema claro: en oscuro hace falta
/// bajar la saturación del color de marca y subir la luminosidad del texto, o
/// el resultado vibra y cansa la vista. Por eso cada esquema se edita entero.
///
/// Los colores de estado (éxito, aviso, error) NO están aquí a propósito:
/// viven en `globals.css` con su variante para cada esquema. Si un admin
/// pudiera cambiarlos, podría dejar los errores ilegibles, y eso no es una
/// decisión de marca.
model Tema {
  id      String       @id @default(cuid())
  esquema EsquemaColor @unique

  /// Los colores, indexados por la clave del token. En JSON y no en una
  /// columna por color: el catálogo de `src/admin/temas.ts` va a seguir
  /// creciendo, y así añadir uno no obliga a una migración. El backend valida
  /// que cada clave exista en el catálogo y que el valor sea hexadecimal, así
  /// que aquí no entra nada arbitrario.
  colores Json

  actualizadoEn    DateTime @updatedAt
  actualizadoPorId String?

  actualizadoPor Admin? @relation(fields: [actualizadoPorId], references: [id])

  @@map("temas")
}

enum RolAdmin {
  SUPERADMIN
  GESTOR
  CONSULTA
}

model Admin {
  id        String   @id @default(cuid())
  correo    String   @unique
  nombre    String
  hashClave String
  rol       RolAdmin @default(GESTOR)
  activo    Boolean  @default(true)

  /// Quien entra con una contraseña que le dieron otros tiene que cambiarla
  /// antes de poder hacer nada. Arranca en `true` porque toda cuenta nueva
  /// nace con una contraseña temporal que conoce quien la creó.
  debeCambiarClave Boolean @default(true)

  // Los completa la propia persona desde "Mi perfil" tras iniciar sesión.
  cargo        String?
  celular      String?
  organizacion String?

  ultimoAcceso  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  movimientos   MovimientoReserva[]
  marcaEditada  Marca[]
  temasEditados Tema[]

  @@map("administradores")
}

/// Apariencia y textos de la aplicación, editables desde el panel.
///
/// Una sola fila: el `id` está fijado a "unica" para que no puedan existir dos
/// configuraciones compitiendo. La app es una, aunque sirva a varios convenios.
///
/// El logo se guarda en la base y no en disco a propósito: así viaja con el
/// backup, sobrevive a `docker compose down` sin depender de un volumen y no
/// hay que sincronizar ficheros entre despliegues. Pesa unos pocos KB.
model Marca {
  id String @id @default("unica")

  nombreApp        String  @default("Convoca")
  tituloPublico    String  @default("Reserve sus cupos de formación")
  subtituloPublico String  @default("La formación es gratuita y los cupos son limitados.")
  piePagina        String?

  /// Qué esquema ve quien entra por primera vez. `SISTEMA` respeta la
  /// preferencia del sistema operativo, que es lo que espera la mayoría.
  modoPorDefecto       ModoPorDefecto @default(SISTEMA)
  /// Si se apaga, el visitante no ve el conmutador y queda fijo el modo por
  /// defecto. Útil si una entidad exige que su sitio se vea siempre igual.
  permitirCambioDeModo Boolean        @default(true)

  logoDatos    Bytes?
  logoTipoMime String?
  logoNombre   String?
  /// Cambia en cada subida y va en la URL del logo: permite cachear el archivo
  /// para siempre y que aun así el navegador vea el nuevo al instante.
  logoVersion  Int     @default(0)

  actualizadoEn    DateTime @updatedAt
  actualizadoPorId String?

  actualizadoPor Admin? @relation(fields: [actualizadoPorId], references: [id])

  @@map("marca")
}
