# Copia de referencia. Instalar en TODAS las sedes con:
#   sudo cp /opt/sep/reservasae/docs/systemd/arrancar-tunel.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now arrancar-tunel.timer

[Unit]
Description=Levanta el tunel si esta sede debe atender
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=sepadmin
WorkingDirectory=/opt/sep/reservasae
ExecStart=/opt/sep/reservasae/scripts/arrancar-tunel.sh
