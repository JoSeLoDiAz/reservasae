# Copia de referencia. Instalar en TODAS las sedes con:
#   sudo cp /opt/sep/reservasae/docs/systemd/autorendirse.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now autorendirse.timer

[Unit]
Description=Se rinde si otra sede va por una linea mayor
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=sepadmin
WorkingDirectory=/opt/sep/reservasae
TimeoutStartSec=30min
ExecStart=/opt/sep/reservasae/scripts/autorendirse.sh
