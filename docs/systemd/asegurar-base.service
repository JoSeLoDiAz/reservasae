# Copia de referencia. Instalar en TODAS las sedes con:
#   sudo cp /opt/sep/reservasae/docs/systemd/asegurar-base.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now asegurar-base.timer

[Unit]
Description=Levanta la base si el arranque la dejo caida
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=sepadmin
WorkingDirectory=/opt/sep/reservasae
ExecStart=/opt/sep/reservasae/scripts/asegurar-base.sh
