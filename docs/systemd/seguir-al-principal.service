# Copia de referencia. Instalar en una replica con:
#   sudo cp /opt/sep/reservasae/docs/systemd/seguir-al-principal.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now seguir-al-principal.timer

[Unit]
Description=Sigue el commit verificado en el principal
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=sepadmin
WorkingDirectory=/opt/sep/reservasae
ExecStart=/opt/sep/reservasae/scripts/seguir-al-principal.sh
