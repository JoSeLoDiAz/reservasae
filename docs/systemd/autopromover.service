# Copia de referencia. Instalar en Bogota y El Socorro,
# NUNCA en el PC Dell:
#   sudo cp /opt/sep/reservasae/docs/systemd/autopromover.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now autopromover.timer
# Ademas hace falta AUTOPROMOVER=si en el .env de la sede.

[Unit]
Description=Promueve esta sede si el principal murio
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=sepadmin
WorkingDirectory=/opt/sep/reservasae
ExecStart=/opt/sep/reservasae/scripts/autopromover.sh
