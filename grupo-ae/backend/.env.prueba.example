# copiar a backend/.env.prueba, que no se sube a git
# entorno de pruebas: base y secreto PROPIOS, nunca los de produccion

NODE_ENV=production
PORT=4000
APP_VERSION=0.1.0-prueba

# marca la franja, y sin ella la siembra falsa se niega
ENTORNO=prueba

# postgres: otra base, otro usuario, otra clave
POSTGRES_USER=reservasae_prueba
POSTGRES_PASSWORD=cambiar-esta-clave-de-pruebas
POSTGRES_DB=reservasae_prueba

# dentro de Docker el host es `db-prueba`
DATABASE_URL=postgresql://reservasae_prueba:cambiar-esta-clave-de-pruebas@db-prueba:5432/reservasae_prueba?schema=public

# fuera de Docker, por el puerto publicado
# DATABASE_URL=postgresql://reservasae_prueba:cambiar-esta-clave-de-pruebas@localhost:5434/reservasae_prueba?schema=public

# distinto al de produccion: una sesion de aqui no
# debe valer alla. Minimo 32 caracteres.
# NO escriba aquí una frase. Genérelo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# El ejemplo de antes era una frase escrita a mano, y eso es
# justo lo que se rompe: el arranque exige 32 caracteres de
# LARGO, no de azar, y una frase humana de 32 caracteres cae
# en un diccionario. Si alguna vez se filtra una sesión
# firmada con este secreto, la atacan sin tocar el servidor.
ADMIN_JWT_SECRET=

# correo saliente: las claves de verdad valen aqui, pero
# TODO se desvia. Sin la linea de abajo no sale ni uno.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=buzon@ejemplo.com
SMTP_CLAVE=clave-de-aplicacion-de-16-letras
SMTP_DESDE=buzon@ejemplo.com
SMTP_NOMBRE=Convoca (pruebas)

# a quien le llega TODO. Separadas por coma.
CORREO_REDIRIGIR_A=alguien@ejemplo.com,otro@ejemplo.com

# a quien SI se le puede preguntar al RUI aqui.
# Sin esto no se consulta a nadie: una cedula inventada le
# pertenece a una persona real. Separadas por coma.
RUI_SOLO_ESTOS_DOCUMENTOS=
